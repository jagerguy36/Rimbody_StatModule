<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/StatDef[defName="CarryWeight"]</xpath>
    <value>
      <capacityOffsets>
        <li>
          <capacity>Rimbody_Brawn</capacity>
          <scale>30</scale>
        </li>
    </capacityOffsets>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/StatDef[defName = "CarryBulk"]</xpath>
    <value>
      <capacityOffsets>
        <li>
          <capacity>Rimbody_Brawn</capacity>
          <scale>10</scale>
        </li>
    </capacityOffsets>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/StatDef[defName = "UnarmedDamage"]</xpath>
    <value>
      <parts>
        <li Class="Maux36.Rimbody_StatModule.PhysiqueMuscleStrengthPart"/>
      </parts>
    </value>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/StatDef[defName = "MeleeParryChance"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>*/StatDef[defName = "MeleeParryChance"]/parts</xpath>
        <order>Prepend</order>
        <value>
        <li Class="Maux36.Rimbody_StatModule.PhysiqueMuscleStrengthPart"/>
        </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName = "MeleeParryChance"]</xpath>
        <order>Prepend</order>
        <value>
          <parts>
            <li Class="Maux36.Rimbody_StatModule.PhysiqueMuscleStrengthPart"/>
          </parts>
        </value>
    </nomatch>
  </Operation>
</Patch>
